{
  "name": "minddrift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MindDrift — local-first Chrome extension that detects focus loss from browsing behavior and gently intervenes.",
  "scripts": {
    "dev": "vite build --watch",
    "dev:hmr": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "zip": "npm run build && cd dist && zip -r ../minddrift-v$npm_package_version.zip ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulKarimBukhshAnsari/MindDrift.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "react",
    "typescript",
    "vite",
    "focus",
    "productivity",
    "minddrift",
    "tabsense"
  ],
  "contributors": [
    {
      "name": "Abdul Karim Bukhsh Ansari",
      "url": "https://github.com/AbdulKarimBukhshAnsari"
    },
    {
      "name": "Sana Jamal",
      "url": "https://github.com/SanaJamal-45"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^8.1.5"
  }
}
